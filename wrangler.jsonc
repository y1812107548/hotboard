{
  "$schema": "https://raw.githubusercontent.com/opennextjs/opennextjs-cloudflare/refs/heads/main/packages/cloudflare/wrangler.json",
  "name": "hotboard",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
